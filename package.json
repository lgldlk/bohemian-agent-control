{
  "name": "bohemian-agent-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api,terminal --prefix-colors cyan,magenta,yellow \"vite --port 18720\" \"pnpm --filter @bohemian/api-server dev\" \"pnpm --filter @bohemian/terminal-server dev\"",
    "dev:web": "vite --port 18720",
    "dev:api": "pnpm --filter @bohemian/api-server dev",
    "dev:terminal": "pnpm --filter @bohemian/terminal-server dev",
    "test:api": "pnpm --filter @bohemian/api-server test",
    "test:protocol": "pnpm --filter @bohemian/agent-protocol test && pnpm --filter @bohemian/terminal-protocol test",
    "test:ui": "pnpm --filter @bohemian/terminal-ui test",
    "test:app": "vitest run --config vitest.config.ts",
    "test": "pnpm test:protocol && pnpm --filter @bohemian/terminal-server test && pnpm --filter @bohemian/api-server test && pnpm test:ui && pnpm test:app",
    "check:type": "pnpm -r --if-present typecheck && tsc --noEmit",
    "check:test": "pnpm test",
    "check:build": "pnpm build",
    "check:bundle": "pnpm perf:bundle",
    "check:all": "pnpm check:type && pnpm check:test && pnpm check:build && pnpm check:bundle",
    "build": "pnpm build:packages && tsc --noEmit && vite build",
    "build:packages": "pnpm --filter @bohemian/agent-protocol build && pnpm --filter @bohemian/terminal-protocol build && pnpm --filter @bohemian/terminal-client build && pnpm --filter @bohemian/terminal-server build && pnpm --filter @bohemian/terminal-ui build && pnpm --filter @bohemian/terminal-canvas build",
    "clean:packages": "find packages -type d -name dist -prune -exec rm -rf {} + && find packages -name tsconfig.tsbuildinfo -delete",
    "preview": "vite preview --port 18720",
    "perf:bundle": "node scripts/check-bundle.mjs"
  },
  "packageManager": "pnpm@11.5.1",
  "dependencies": {
    "@bohemian/agent-protocol": "workspace:*",
    "@bohemian/terminal-canvas": "workspace:*",
    "@bohemian/terminal-client": "workspace:*",
    "@bohemian/terminal-protocol": "workspace:*",
    "@bohemian/terminal-ui": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-hierarchy": "^3.1.2",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.0.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.468.0",
    "react-i18next": "^17.0.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^2.6.0",
    "tldraw": "^5.4.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^22",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
